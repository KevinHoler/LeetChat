@using BlazorChatApp.Shared.DTO
@inject IJSRuntime JS

<div class="d-flex flex-column h-100">

    <div class="border-bottom px-3 py-2 bg-black text-success">
        > @ConversationName _
    </div>

    <div class="flex-grow-1 overflow-auto p-3 bg-black text-success" id="message-container">
        @if (IsLoading)
        {
            <div class="text-center text-muted mt-4">Laddar...</div>
        }
        else
        {
            @foreach (var msg in ChatMessages)
            {
                var isMine = msg.SenderUsername == CurrentUser;
                <div class="message-row @(isMine ? "mine" : "theirs")">
                    @if (!isMine)
                    {
                        <div class="msg-meta">
                            <span class="username">@msg.SenderUsername</span>
                            <span class="time">@msg.Timestamp.ToLocalTime():HH:mm</span>
                        </div>
                        <span class="content">@msg.Content</span>
                    }
                    else
                    {
                        <span class="content">@msg.Content</span>
                        <span class="time">@msg.Timestamp.ToLocalTime()</span>
                    }
                </div>
            }
            <div id="message-bottom"></div>
        }
    </div>

    <div class="terminal-input">

        <span class="prompt">></span>

        <input class="terminal-field"
               placeholder="type message..."
               @bind="_input"
               @bind:event="oninput"
               @onkeydown="OnKeyDown" />

        <button class="terminal-btn"
                @onclick="Send"
                disabled="@string.IsNullOrWhiteSpace(_input)">
            SEND
        </button>

    </div>
</div>

<style>
    .terminal-input {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px;
        border-top: 1px solid rgba(0,255,0,0.2);
        background: rgba(0,0,0,0.6);
        font-family: "Fira Code", monospace;
    }

    .prompt {
        color: #33ff66;
    }

    .terminal-field {
        flex: 1;
        background: transparent;
        border: none;
        outline: none;
        color: #33ff66;
        font-family: "Fira Code", monospace;
    }

        .terminal-field::placeholder {
            color: rgba(51,255,102,0.4);
        }

    .terminal-btn {
        background: transparent;
        border: 1px solid #33ff66;
        color: #33ff66;
        padding: 5px 12px;
        cursor: pointer;
    }

        .terminal-btn:hover {
            background: rgba(0,255,0,0.1);
        }

        .terminal-btn:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

    .message-row {
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 6px 12px;
        font-family: "Fira Code", monospace;
        color: #33ff66;
    }

        .message-row + .message-row {
            margin-top: 6px;
        }

    .msg-meta {
        display: flex;
        gap: 10px;
        font-size: 0.75rem;
        opacity: 0.6;
    }

    .username {
        color: #00ff88;
        font-weight: bold;
    }

    .content {
        padding-left: 10px;
        border-left: 2px solid rgba(51,255,102,0.2);
    }
</style>

@code {
    [Parameter] public int ConversationId { get; set; }
    [Parameter] public string ConversationName { get; set; } = "";
    [Parameter] public string CurrentUser { get; set; } = "";
    [Parameter] public List<MessageDto> ChatMessages { get; set; } = new();
    [Parameter] public EventCallback<string> OnSendMessage { get; set; }
    [Parameter] public bool IsLoading { get; set; }

    private string _input = "";

    protected override async Task OnParametersSetAsync()
    {
        await ScrollToBottom();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await ScrollToBottom();
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        var msg = _input.Trim();
        _input = "";
        await OnSendMessage.InvokeAsync(msg);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await Send();
    }

    private async Task ScrollToBottom()
    {
        try { await JS.InvokeVoidAsync("scrollToElement", "message-bottom"); }
        catch { }
    }
}