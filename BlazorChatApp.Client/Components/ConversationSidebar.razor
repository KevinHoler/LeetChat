@using BlazorChatApp.Shared.DTO
@inject HttpClient HttpClient

<div class="terminal-search">

    <span class="prompt">></span>

    <input type="text"
           class="terminal-search-input"
           placeholder="search user..."
           value="@_searchQuery"
           @oninput="OnSearchInput" />

    @if (!string.IsNullOrWhiteSpace(_searchQuery))
    {
        <button class="terminal-clear" @onclick="ClearSearch">×</button>
    }

</div>

@if (_searchResults.Any())
{
    <div class="search-results">

        @foreach (var user in _searchResults)
        {
            <div class="search-user"
                 @onclick="() => StartConversationClicked(user.Id)">

                <span class="avatar">@user.Username[0]</span>
                <span class="name">@user.Username</span>

            </div>
        }

    </div>
}

<div class="flex-grow-1 overflow-auto">
    <div class="px-2 pt-1 text-muted small">Konversationer</div>
    @if (!Conversations.Any())
    {
        <div class="text-muted small px-2 py-3">Inga konversationer ännu</div>
    }
    @foreach (var conv in Conversations)
    {
        <div class="px-2 py-2 chat-item @(conv.Id == SelectedConversationId ? "active" : "")"
             @onclick="() => OnSelectConversation.InvokeAsync(conv.Id)"
             style="cursor:pointer">
            <div class="d-flex">
                <div class="avatar me-2">@conv.Name[0]</div>
                <div class="overflow-hidden">
                    <div class="fw-semibold text-truncate">@conv.Name</div>
                    <div class="text-muted small text-truncate">@conv.LastMessage</div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .chat-item {
        padding: 10px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #33ff66;
        font-family: "Fira Code", monospace;
    }

        .chat-item:hover {
            background: rgba(0,255,0,0.05);
        }

        .chat-item.active {
            background: rgba(0,255,0,0.1);
            border-left: 2px solid #33ff66;
        }

    .terminal-search {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px;
        border-bottom: 1px solid rgba(0,255,0,0.15);
        background: rgba(0,0,0,0.6);
        color: #33ff66;
        font-family: "Fira Code", monospace;
    }

    .prompt {
        color: #33ff66;
        opacity: 0.8;
    }

    .terminal-search-input {
        flex: 1;
        background: transparent;
        border: none;
        outline: none;
        color: #33ff66;
        font-family: "Fira Code", monospace;
    }

        .terminal-search-input::placeholder {
            color: rgba(51,255,102,0.4);
        }

    .terminal-clear {
        background: transparent;
        border: 1px solid #33ff66;
        color: #33ff66;
        cursor: pointer;
        padding: 2px 8px;
    }

        .terminal-clear:hover {
            background: rgba(0,255,0,0.1);
        }

    .avatar {
        width: 28px;
        height: 28px;
        border: 1px solid #33ff66;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .search-results {
        border-bottom: 1px solid rgba(0,255,0,0.15);
        background: rgba(0,0,0,0.4);
    }

    .search-user {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 10px;
        cursor: pointer;
        color: #33ff66;
        font-family: "Fira Code", monospace;
    }

        .search-user:hover {
            background: rgba(0,255,0,0.08);
        }

        .search-user .avatar {
            width: 24px;
            height: 24px;
            border: 1px solid #33ff66;
            display: flex;
            align-items: center;
            justify-content: center;
        }
</style>

@code {
    [Parameter] public List<ConversationDto> Conversations { get; set; } = new();
    [Parameter] public int? SelectedConversationId { get; set; }
    [Parameter] public EventCallback<int> OnSelectConversation { get; set; }
    [Parameter] public EventCallback<int> OnStartConversation { get; set; }

    private string _searchQuery = "";
    private List<UserSearchResultDto> _searchResults = new();
    private CancellationTokenSource? _searchCts;

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? "";

        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();

        if (_searchQuery.Length < 2)
        {
            _searchResults = new();
            return;
        }

        try
        {
            await Task.Delay(300, _searchCts.Token);

            var results = await HttpClient.GetFromJsonAsync<List<UserSearchResultDto>>(
                $"api/user/search?q={Uri.EscapeDataString(_searchQuery)}",
                _searchCts.Token);

            _searchResults = results ?? new();
        }
        catch (OperationCanceledException)
        {
            // expected during typing
        }
    }

    private async Task StartConversationClicked(int userId)
    {
        ClearSearch();
        await OnStartConversation.InvokeAsync(userId);
    }

    private void ClearSearch()
    {
        _searchQuery = "";
        _searchResults = new();
    }
}