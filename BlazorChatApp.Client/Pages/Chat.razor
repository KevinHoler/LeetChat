@page "/chat"
@using Microsoft.AspNetCore.SignalR.Client
@using BlazorChatApp.Shared.DTO
@inject NavigationManager NavigationManager
@inject HttpClient HttpClient
@inject IAuthService Auth
@implements IAsyncDisposable

<div class="chat-os">

    <div class="os-topbar">
        <span>> LEETCHAT TERMINAL</span>

        <div class="os-user">
            @Auth.Name
            <button @onclick="Logout">[ EXIT ]</button>
        </div>
    </div>

    <div class="os-body">

        <div class="os-sidebar">
            <ConversationSidebar Conversations="Conversations"
                                 SelectedConversationId="_selectedConversationId"
                                 OnSelectConversation="SelectConversation"
                                 OnStartConversation="StartConversation" />
        </div>

        <div class="os-chat">
            @if (_selectedConversationId.HasValue)
            {
                <Messages ConversationId="_selectedConversationId.Value"
                          ConversationName="@(Conversations.FirstOrDefault(c => c.Id == _selectedConversationId)?.Name ?? "")"
                          CurrentUser="@Auth.Name"
                          ChatMessages="_messages"
                          OnSendMessage="SendMessage"
                          IsLoading="_loadingMessages" />
            }
            else
            {
                <div class="empty-state">
                    SELECT CONVERSATION OR INITIATE CONNECTION...
                </div>
            }
        </div>

    </div>

</div>

@code {
    private HubConnection? _hub;
    private List<ConversationDto> Conversations { get; set; } = new();
    private List<MessageDto> _messages = new();
    private int? _selectedConversationId;
    private bool _loadingMessages;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/");
            return;
        }

        await LoadConversations();
        await ConnectHub();
    }

    private async Task LoadConversations()
    {
        var result = await HttpClient.GetFromJsonAsync<List<ConversationDto>>("api/conversation");
        Conversations = result ?? new();
    }

    private async Task ConnectHub()
    {
        _hub = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/chathub"), opts =>
            {
                opts.AccessTokenProvider = () => Task.FromResult<string?>(Auth.Token);
            })
            .WithAutomaticReconnect()
            .Build();

        _hub.On<MessageDto>("ReceiveMessage", msg =>
        {
            if (msg.ConversationId == _selectedConversationId)
            {
                _messages.Add(msg);
                InvokeAsync(StateHasChanged);
            }
            var conv = Conversations.FirstOrDefault(c => c.Id == msg.ConversationId);
            if (conv != null)
            {
                var idx = Conversations.IndexOf(conv);
                Conversations[idx] = conv with { LastMessage = msg.Content, LastActivity = msg.Timestamp };
                Conversations = Conversations.OrderByDescending(c => c.LastActivity).ToList();
                InvokeAsync(StateHasChanged);
            }
        });

        _hub.On<ConversationDto>("ConversationStarted", conv =>
        {
            Conversations.Insert(0, conv);
            InvokeAsync(StateHasChanged);
        });

        await _hub.StartAsync();
    }

    private async Task SelectConversation(int conversationId)
    {
        _selectedConversationId = conversationId;
        _loadingMessages = true;
        _messages = new();
        StateHasChanged();

        var msgs = await HttpClient.GetFromJsonAsync<List<MessageDto>>($"api/conversation/{conversationId}/messages");
        _messages = msgs ?? new();
        _loadingMessages = false;
        StateHasChanged();
    }

    private async Task StartConversation(int targetUserId)
    {
        var response = await HttpClient.PostAsJsonAsync("api/conversation/start", new StartConversationDto(targetUserId));
        if (!response.IsSuccessStatusCode) return;

        var conv = await response.Content.ReadFromJsonAsync<ConversationDto>();
        if (conv == null) return;

        if (!Conversations.Any(c => c.Id == conv.Id))
            Conversations.Insert(0, conv);

        if (_hub is not null)
            await _hub.InvokeAsync("JoinConversation", conv.Id);

        await SelectConversation(conv.Id);
    }

    private async Task SendMessage(string content)
    {
        if (_hub is null || _selectedConversationId is null || string.IsNullOrWhiteSpace(content)) return;
        await _hub.InvokeAsync("SendMessage", _selectedConversationId.Value, content);
    }

    private async Task Logout()
    {
        await Auth.LogoutAsync();
        NavigationManager.NavigateTo("/");
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
            await _hub.DisposeAsync();
    }
}